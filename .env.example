# APIキー等の置き場のテンプレート。
#
# 使い方:
#   1. このファイルを .env という名前でコピーする
#   2. 必要な行のコメント（#）を外し、値を入れる
#
# .env は .gitignore で除外されているため、Git には入らない。
# 同名の環境変数があれば、そちらが優先される（一時的な上書き用）。
#
# 置き場を変えたい場合は config.toml の [paths] secrets_file を書き換える。

# Claude API（[decision] mode が llm_first / jev_first のとき）
#ANTHROPIC_API_KEY=sk-ant-...

# Jev Decision API（jev_first のとき）
#JEV_API_KEY=...

# OpenAI 互換エンドポイント（engine に openai_compat を使うとき）
#OPENAI_API_KEY=...

# GitHub Issue の読み取り（[github] repo を設定したとき）
#GITHUB_TOKEN=ghp_...
